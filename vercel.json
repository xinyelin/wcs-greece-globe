{
  "buildCommand": "node sync-once.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(vendor|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(earth|earth-gilded|earth-gilded-hd|earth-gilded-2k).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/classic",
      "destination": "/classic.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-sheet",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "api/sync-sheet.js": {
      "maxDuration": 60
    }
  }
}