{
  "buildCommand": "node -e \"(async()=>{const h=require('./api/sync-sheet');let c=200;const req={headers:{authorization:'Bearer '+(process.env.CRON_SECRET||'')}};const res={status(x){c=x;return this},json(x){console.log(JSON.stringify(x));if(c>=400)process.exitCode=1;return x}};await h(req,res);if(c>=400)process.exit(c)})().catch(e=>{console.error(e);process.exit(1)})\"",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(vendor|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(earth|earth-gilded|earth-gilded-hd|earth-gilded-2k).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/classic",
      "destination": "/classic.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-sheet",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "api/sync-sheet.js": {
      "maxDuration": 60
    }
  }
}